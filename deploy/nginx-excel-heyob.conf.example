# excel.heyob.co.kr — Ubuntu excel EC2 (/etc/nginx/sites-available/excel)
# Cloudflare Origin 인증서: /etc/ssl/cloudflare/heyob.pem + heyob.key
# 앱은 127.0.0.1:3000 (pm2). 보안그룹 80·443, Cloudflare 레코드는 Proxied.
# 공개 URL은 https://excel.heyob.co.kr 만. http://3.37.127.90:3000 쓰지 말 것.

server {
    listen 80;
    server_name excel.heyob.co.kr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name excel.heyob.co.kr;

    ssl_certificate     /etc/ssl/cloudflare/heyob.pem;
    ssl_certificate_key /etc/ssl/cloudflare/heyob.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 35M;

    location /_next/static/ {
        alias __NEXT_STATIC_DIR__/;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /api/events {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        chunked_transfer_encoding on;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
}
